@startuml
skinparam state {
  BackgroundColor LightBlue
  BorderColor DarkBlue
  FontName Arial
}

title Projection Cinemax State Diagram

[*] --> In_Selezione : Inizio creazione proiezione

state In_Selezione {
  In_Selezione : Il proiezionista seleziona film, data e prezzo
}

In_Selezione --> In_Attesa_Conferma : Invia richiesta (StoreProjection)
In_Selezione --> Annullata : Utente chiude dialog
In_Selezione --> Modifica : Invia richiesta

state In_Attesa_Conferma {
  In_Attesa_Conferma : Application verifica disponibilità sul server
}

In_Attesa_Conferma --> Confermata : Verifica OK (StoreProjectionResponse: success=true)
In_Attesa_Conferma --> In_Selezione : Verifica KO (data_ora non disponibili)

state Confermata {
  Confermata : Proiezione registrata nel DB
}

Confermata --> [*] : Fine ciclo vita
Confermata --> Modifica : Utente modifica (UpdateProjection)
Confermata --> Annullata : Utente disdice (DeleteProjection)

state Annullata {
  Annullata : Data e ora liberati nel DB
}

state Modifica {
Modifica : Modifica data e ora nel DB
}

Annullata --> [*] : Fine ciclo vita
Modifica --> [*] : Fine ciclo vita

@enduml